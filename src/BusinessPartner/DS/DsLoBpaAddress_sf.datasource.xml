<DataSource name="DsLoBpaAddress" backendSystem="sf" businessObjectClass="LoBpaAddress" external="false" editableEntity="Account" schemaVersion="2.0">
  <Attributes>
    <Attribute name="pKey" table="Account" column="Id" />
    <DerivedAttribute name="referencePKey" value="Account.Id" />
    <DerivedAttribute name="usage" value="'Delivery'" />
    <DerivedAttribute name="main" value="'1'" />
    <Attribute name="street" table="Account" column="BillingStreet" />
    <DerivedAttribute name="houseNumber" value="' '" />
    <Attribute name="zipCode" table="Account" column="BillingPostalCode" />
    <Attribute name="city" table="Account" column="BillingCity" />
    <Attribute name="countryState" table="Account" column="BillingState" />
    <Attribute name="country" table="Account" column="BillingCountry" />
    <Attribute name="latitude" table="Account" column="BillingLatitude" />
    <Attribute name="longitude" table="Account" column="BillingLongitude" />
    <DerivedAttribute name="address" value="Account.BillingStreet ||', ' || Account.BillingPostalCode || ' ' || Account.BillingCity || ', ' || Account.BillingState" />
    <DerivedAttribute name="zipCodeAndCity" value="Account.BillingPostalCode || ' ' || Account.BillingCity " />
  </Attributes>
  <Entities>
    <Entity name="Account" alias="" idAttribute="Id" />
  </Entities>
  <QueryCondition><![CDATA[
       Account.Id = #referencePKey#
        ]]></QueryCondition>
  <OrderCriteria />
  <Parameters>
    <Parameter name="referencePKey" type="TEXT" />
  </Parameters>
</DataSource>