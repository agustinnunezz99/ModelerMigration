<UIDescription name="Customer::MyAssignNewESPWizardUI" schemaVersion="0.0.0.5">
  <Page pagePattern="SingleSectionDialogPage" onBackDiscard="true">
    <PageHeader>
      <Bindings>
        <Resource target="title" type="Label" id="AssingNewESPTitleId" defaultLabel="Asignar nueva especialidad" />
      </Bindings>
      <MenuItems>
        <MenuItem directlyVisible="true" itemId="done">
          <Bindings>
            <Resource target="Text" type="Label" id="doneId" defaultLabel="Finalizar" />
            <Resource target="Icon" type="Image" id="CheckGrey24" defaultImage="CheckGrey24" />
          </Bindings>
          <Events>
            <ButtonPressedEvent event="createEspecialidad">
              <Params>
                <Param name="buttonPressed" value="createEspecialidad" />
              </Params>
            </ButtonPressedEvent>
          </Events>
        </MenuItem>
      </MenuItems>
    </PageHeader>
    <Section sectionName="masterSection" sectionPattern="SingleAreaSection">
      <Area areaName="mainArea" areaPattern="GroupedElementsArea">
        <GroupElement name="NewESP">
          <Lookup name="Especialidad">
            <Bindings>
              <Resource target="Label" type="Label" defaultLabel="Especialidad" id="EspecialidadId" />
              <Binding target="Value" binding="ProcessContext::validationBo.luEspecialidad.name" bindingMode="TWO_WAY" />
            </Bindings>
            <Events>
              <LookupEvent event="especialidadLookup" />
            </Events>
          </Lookup>
        </GroupElement>
      </Area>
    </Section>
  </Page>
</UIDescription>