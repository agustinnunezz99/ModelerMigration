<Process name="Customer::MyInstitutionProcess" defaultAction="ShowView" schemaVersion="0.0.0.5">
  <Entry>
    <ProcessContext>
      <Declarations></Declarations>
      <Parameters>
        <Input name="InstitutionList" type="LoMyInstitutionOverview" />
        <Input name="institutionPKey" type="DomPKey" />
        <Input name="institutionName" type="DomBpaName" />
      </Parameters>
    </ProcessContext>
    <EntryActions>
      <Action actionType="LOAD" name="GetInstitutionList" type="LoMyInstitutionOverview">
        <Parameters>
          <Input name="considerSubstitutionLeadFollowUpTime" type="Literal" value="1" />
          <Input name="mode" type="Literal" value="order" />
        </Parameters>
        <Return name="ProcessContext::InstitutionList" />
      </Action>
    </EntryActions>
  </Entry>
  <Body>
    <Actions>
      <Action actionType="View" name="ShowView">
        <UIDescription>Customer::MyInstitutionUI</UIDescription>
        <Events>
          <Event name="itemSelected" action="EndWithNewValue" />
        </Events>
      </Action>
      <Action actionType="END" name="EndWithNewValue">
        <ReturnValues>
          <Return name="pKey" value="Event.pKey" />
          <Return name="institutionName" value="Event.name" />
        </ReturnValues>
      </Action>
      <Action actionType="END" name="End">
        <ReturnValues>
          <Return name="pKey" value="ProcessContext::institutionPKey" />
          <Return name="institutionName" value="ProcessContext::institutionName" />
        </ReturnValues>
      </Action>
    </Actions>
  </Body>
</Process>