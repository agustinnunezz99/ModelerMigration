              <ItemListLayout>
                <Default>
                  <Col flex="1">
                    <Row layoutType="itemSecondarySmall" bindingId="horarioName" />
                    <Row layoutType="itemIdentifier" bindingId="horarioDays" />
                    <Row>
                      <Col layoutType="itemValue" bindingId="horarioTimeFrom" />
                      <Col width="1em" layoutType="itemSecondary" bindingId="Spacer" />
                      <Col layoutType="itemValue" bindingId="horarioTimeUntil" />
                    </Row>
                  </Col>
                </Default>
              </ItemListLayout>
              <Bindings>
                <Binding target="horarioName" type="Text" binding=".name" bindingMode="ONE_WAY" />
                <Binding target="horarioDays" type="Text" binding=".availableDays" bindingMode="ONE_WAY" />
                <Binding target="horarioTimeFrom" type="Text" binding=".timeFrom" bindingMode="ONE_WAY" />
                <Binding target="horarioTimeUntil" type="Text" binding=".timeUntil" bindingMode="ONE_WAY" />
              </Bindings>
            </Items>
            <Events>
              <ItemSelectedEvent event="horarioSelected">
                <SelectArea name="HorarioEdit" />
                <Params>
                  <Param name="pKey" value=".pKey" />
                </Params>
              </ItemSelectedEvent>
            </Events>
