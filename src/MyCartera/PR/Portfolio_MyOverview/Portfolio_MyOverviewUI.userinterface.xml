<UIDescription name="Portfolio::MyOverviewUI" schemaVersion="0.0.0.5" xmlns="UISchema.xsd" simpleEditorOnly="true">
  <Page pagePattern="MasterDetailSectionPage" selectFirstItemInList="true" masterSectionFlex="40" detailSectionFlex="60" cachable="false">
    <ViewVariables>
      <ViewVariable name="currentTabName" value="Main" />
    </ViewVariables>
    <PageHeader>
      <Bindings>
        <Resource target="title" type="Label" id="PortfolioTitleId" defaultLabel="Cartera" bindingMode="ONE_TIME" />
      </Bindings>
    </PageHeader>
    <Section sectionName="masterSection" sectionPattern="SingleAreaSection">
      <Area areaName="mainArea" areaPattern="SingleElementArea">
        <GroupedList name="PortfolioList" searchable="true" groupBy="grouping1" master="true" dataSource="ProcessContext::PortfolioList.Items[]" indexBar="true">
          <SearchAttributes>
            <SearchAttribute name="Name" />
            <SearchAttribute name="SalesZone" />
          </SearchAttributes>
          <Items name="PortfolioItems" itemPattern="PortfolioOverviewItem">
            <ItemListLayout>
              <Default>
                <Col>
                  <Row layoutType="itemIdentifier" bindingId="Name" />
                  <Row layoutType="itemSecondary" bindingId="Shift" />
                </Col>
                <Col width="1em">
                  <Row layoutType="itemValue" bindingId="Spacer" />
                </Col>
                <Col align="right">
                  <Row layoutType="itemIdentifier pull-right" bindingId="Coverage" />
                </Col>
              </Default>
            </ItemListLayout>
            <Bindings>
              <Binding target="Name" type="Text" binding=".name" bindingMode="ONE_WAY" />
              <Binding target="SalesZone" type="Text" binding=".salesZone" bindingMode="ONE_WAY" />
              <Binding target="Shift" type="Text" binding=".shift" bindingMode="ONE_WAY" />
              <Binding target="Coverage" type="Image" binding=".coverageImage" bindingMode="ONE_WAY" />
            </Bindings>
          </Items>
          <Events>
            <ItemSelectedEvent event="itemSelected" resetMultiAreas="true">
              <Params>
                <Param name="pKey" value=".pKey" />
                <Param name="tabName" value="View::currentTabName" />
              </Params>
            </ItemSelectedEvent>
          </Events>
        </GroupedList>
      </Area>
    </Section>
    <Section sectionName="detailSection" sectionPattern="TabbedViewAreaSection" currentTab="View::currentTabName">
      <Area areaName="tabArea" areaPattern="TabElementArea">
        <TabSelector name="TabSelector">
          <Items>
            <Tab tabName="Main" backendSystem="both">
              <Bindings>
                <Resource target="image" type="Image" id="MainGrey24" defaultImage="MainGrey24" bindingMode="ONE_TIME" />
                <Resource target="text" type="Label" id="MainId" defaultLabel="Main" bindingMode="ONE_TIME" />
              </Bindings>
            </Tab>
            <Tab tabName="Visits" backendSystem="both">
              <Bindings>
                <Binding type="Visible" target="Visible" binding="ProcessContext::VisitTabVisible" />
                <Resource target="image" type="Image" id="SuitcaseGrey24" defaultImage="SuitcaseGrey24" bindingMode="ONE_TIME" />
                <Resource target="text" type="Label" id="VisitasId" defaultLabel="Visitas" bindingMode="ONE_TIME" />
              </Bindings>
            </Tab>
            <Tab tabName="Previstos" backendSystem="both">
              <Bindings>
                <Binding type="Visible" target="Visible" binding="ProcessContext::PrevistosTabVisible" />
                <Resource target="image" type="Image" id="MyActivityBlueGray24" defaultImage="MyActivityBlueGray24" bindingMode="ONE_TIME" />
                <Resource target="text" type="Label" id="PrevistoId" defaultLabel="Previstos" bindingMode="ONE_TIME" />
              </Bindings>
            </Tab>
            <Tab tabName="Especialidades" backendSystem="both">
              <Bindings>
                <Binding type="Visible" target="Visible" binding="ProcessContext::SpecialtiesTabVisible" />
                <Resource target="image" type="Image" id="ShelfGrey24" defaultImage="ShelfGrey24" bindingMode="ONE_TIME" />
                <Resource target="text" type="Label" id="EspecialidadesId" defaultLabel="Especialidades" bindingMode="ONE_TIME" />
              </Bindings>
            </Tab>
            <Tab tabName="Horarios" backendSystem="both">
              <Bindings>
                <Binding type="Visible" target="Visible" binding="ProcessContext::HoursTabVisible" />
                <Resource target="image" type="Image" id="ClockGrey24" defaultImage="ClockGrey24" bindingMode="ONE_TIME" />
                <Resource target="text" type="Label" id="HorariosId" defaultLabel="Horarios" bindingMode="ONE_TIME" />
              </Bindings>
            </Tab>
            <Tab tabName="Secretarias" backendSystem="both">
              <Bindings>
                <Binding type="Visible" target="Visible" binding="ProcessContext::SecretariesTabVisible" />
                <Resource target="image" type="Image" id="UserGrey24" defaultImage="UserGrey24" bindingMode="ONE_TIME" />
                <Resource target="text" type="Label" id="SecretariesId" defaultLabel="Secretarias" bindingMode="ONE_TIME" />
              </Bindings>
            </Tab>
          </Items>
          <Events>
            <ItemSelectedEvent event="tabSelected" storeTabNameIn="currentTabName" />
          </Events>
        </TabSelector>
      </Area>
      <Area areaName="Main" areaPattern="MultiArea">
        <Area areaName="Main" areaPattern="GroupedElementsArea">
          <MenuItems></MenuItems>
          <GroupElement name="DetailGroup">
            <Bindings>
              <Resource target="Title" type="Label" id="DetailId" defaultLabel="Detalle" />
            </Bindings>
            <InputArea name="Id" editable="false">
              <Bindings>
                <Resource target="Label" type="Label" defaultLabel="Id" id="IdId" />
                <Binding target="Value" binding="ProcessContext::PortfolioDetail.pKey" bindingMode="ONE_WAY" />
              </Bindings>
            </InputArea>
            <InputArea name="Name" editable="false">
              <Bindings>
                <Resource target="Label" type="Label" defaultLabel="Nombre de la cuenta" id="NameId" />
                <Binding target="Value" binding="ProcessContext::PortfolioDetail.name" bindingMode="ONE_WAY" />
              </Bindings>
            </InputArea>
            <InputArea name="SalesZone" editable="false">
              <Bindings>
                <Resource target="Label" type="Label" defaultLabel="Zona de Ventas" id="SalesZoneId" />
                <Binding target="Value" binding="ProcessContext::PortfolioDetail.salesZone" bindingMode="ONE_WAY" />
              </Bindings>
            </InputArea>
            <DatePickerField name="AssignmentDate" editable="false">
              <Bindings>
                <Resource target="Label" type="Label" defaultLabel="Fecha de asignación" id="AssignmentDateId" />
                <Binding target="Value" binding="ProcessContext::PortfolioDetail.assignmentDate" bindingMode="TWO_WAY" />
              </Bindings>
            </DatePickerField>
            <DatePickerField name="EndAssignmentDate" editable="false">
              <Bindings>
                <Resource target="Label" type="Label" defaultLabel="Fecha fin asignación" id="EndAssignmentDateId" />
                <Binding target="Value" binding="ProcessContext::PortfolioDetail.endAssignmentDate" bindingMode="TWO_WAY" />
              </Bindings>
            </DatePickerField>
            <DatePickerField name="LastVisitDate" editable="false">
              <Bindings>
                <Resource target="Label" type="Label" defaultLabel="Ultima Visita" id="LastVisitDateId" />
                <Binding target="Value" binding="ProcessContext::PortfolioDetail.lastVisitDateCustom" bindingMode="TWO_WAY" />
              </Bindings>
            </DatePickerField>
            <SelectionBox name="Frequency">
              <Bindings>
                <Resource target="Label" type="Label" id="FreqId" defaultLabel="Frecuencia" />
                <Binding target="DataSource" toggleId="DomPortFreq" bindingMode="TWO_WAY" />
                <Binding target="Value" binding="ProcessContext::PortfolioDetail.freq" bindingMode="TWO_WAY" />
              </Bindings>
              <Items>
                <Bindings>
                  <Binding target="ItemValue" type="Text" binding=".id" bindingMode="ONE_WAY" />
                  <Binding target="ItemText" type="Text" binding=".text" bindingMode="ONE_WAY" />
                </Bindings>
              </Items>
            </SelectionBox>
            <SelectionBox name="Shift">
              <Bindings>
                <Resource target="Label" type="Label" id="ShiftId" defaultLabel="Tarea" />
                <Binding target="DataSource" toggleId="DomPortShift" bindingMode="TWO_WAY" />
                <Binding target="Value" binding="ProcessContext::PortfolioDetail.shift" bindingMode="TWO_WAY" />
              </Bindings>
              <Items>
                <Bindings>
                  <Binding target="ItemValue" type="Text" binding=".id" bindingMode="ONE_WAY" />
                  <Binding target="ItemText" type="Text" binding=".text" bindingMode="ONE_WAY" />
                </Bindings>
              </Items>
            </SelectionBox>
            <SelectionBox name="Category">
              <Bindings>
                <Resource target="Label" type="Label" id="FreqId" defaultLabel="Categoria" />
                <Binding target="DataSource" toggleId="DomPortCategory" bindingMode="TWO_WAY" />
                <Binding target="Value" binding="ProcessContext::PortfolioDetail.category" bindingMode="TWO_WAY" />
              </Bindings>
              <Items>
                <Bindings>
                  <Binding target="ItemValue" type="Text" binding=".id" bindingMode="ONE_WAY" />
                  <Binding target="ItemText" type="Text" binding=".text" bindingMode="ONE_WAY" />
                </Bindings>
              </Items>
            </SelectionBox>
            <SelectionBox name="ZoneType">
              <Bindings>
                <Resource target="Label" type="Label" id="ZoneTypeId" defaultLabel="Tipo de Zona" />
                <Binding target="DataSource" toggleId="DomPortZoneType" bindingMode="TWO_WAY" />
                <Binding target="Value" binding="ProcessContext::PortfolioDetail.zoneType" bindingMode="TWO_WAY" />
              </Bindings>
              <Items>
                <Bindings>
                  <Binding target="ItemValue" type="Text" binding=".id" bindingMode="ONE_WAY" />
                  <Binding target="ItemText" type="Text" binding=".text" bindingMode="ONE_WAY" />
                </Bindings>
              </Items>
            </SelectionBox>
            <!-- CON IMAGEN -->
            <Merger name="PortfolioCoverageMerge" pattern="twoInputControls" labelHandling="Combined" separator="," leftRatio="0" rightRatio="0">
              <ImageButton name="PortfolioCoverageImage">
                <Bindings>
                  <Resource target="Label" type="Label" defaultLabel="Cobertura" id="CoberturaId" />
                  <Binding target="Image" type="Image" binding="ProcessContext::PortfolioDetail.coverageImage" bindingMode="ONE_WAY" />
                </Bindings>
                <Events>
                  <ButtonPressedEvent event="mailPressed" />
                </Events>
              </ImageButton>
            </Merger>
            <!-- solo color 
            <Merger name="PortfolioCoverageMerge2" pattern="twoInputControls" labelHandling="Combined" separator="," leftRatio="0" rightRatio="0">
              <ImageButton name="PortfolioCoverageImage2"  >
                <Bindings>
                	<Resource target="Label" type="Label" defaultLabel="Cobertura" id="CoberturaId" />
                    <Binding target="backColor" type="Color" binding="ProcessContext::PortfolioDetail.coverageColor" bindingMode="ONE_WAY" />
                </Bindings>
                <Events>
                  <ButtonPressedEvent event="mailPressed" />
                </Events>
              </ImageButton>
            </Merger>-->
          </GroupElement>
          <!-- -->
          <GroupElement name="DetailGroup2">
            <Bindings>
              <Resource target="Title" type="Label" id="CoverageId" defaultLabel="Cobertura" />
            </Bindings>
          </GroupElement>
        </Area>
      </Area>
      <!-- VISITAS TAB - @JuanFelipe - Historia FMG-91 -->
      <Area areaName="Visits" areaPattern="SingleElementArea" lazyLoading="true">
        <GroupedList name="PortfolioVisitList" searchable="false" dataSource="ProcessContext::PortfolioDetail.LoMyPortfolioVisit.Items[]" hasBorder="true">
          <!--<SearchAttributes>
            <SearchAttribute name="Subject" />
          </SearchAttributes> -->
          <Items name="Items" itemPattern="PortfolioVisitItem">
            <ItemListLayout>
              <Default>
                <Col width="2.1em" height="1.4em" layoutType="Image" bindingId="typeWithStatusImage" />
                <Col>
                  <Row>
                    <Col layoutType="itemIdentifier" bindingId="Description" />
                  </Row>
                  <Row>
                    <Col width="1.5em" layoutType="Image" bindingId="DateImageId" />
                    <Col width="6em" layoutType="itemSecondary" bindingId="DateFrom" />
                    <Col width="1.5em" layoutType="Image" bindingId="TimeImageId" />
                    <Col width="4em" layoutType="itemSecondary" bindingId="TimeFrom" />
                  </Row>
                  <Row>
                    <Col width="1.5em" layoutType="Image" bindingId="ResponsibleImageId" />
                    <Col layoutType="itemValue" bindingId="Responsible" />
                  </Row>
                </Col>
              </Default>
              <Tablet>
                <Default>
                  <Col width="2.5em" height="1.4em" layoutType="Image" bindingId="typeWithStatusImage" />
                  <Col height="2.5em">
                    <Row layoutType="itemIdentifier" bindingId="Description" />
                    <Row layoutType="itemPaddingTop">
                      <Col width="1.3em" height="1.6em" layoutType="Image" bindingId="DateImageId" />
                      <Col width="7em" layoutType="itemSecondary itemPaddingTop" bindingId="DateFrom" />
                      <Col width="1.3em" height="1.6em" layoutType="Image" bindingId="TimeImageId" />
                      <Col width="4.2em" layoutType="itemSecondary itemPaddingTop" bindingId="TimeFrom" />
                      <Col width="1.3em" height="1.6em" layoutType="Image" bindingId="ResponsibleImageId" />
                      <Col layoutType="itemValue" bindingId="Responsible" />
                    </Row>
                  </Col>
                </Default>
                <Apple>
                  <Col width="2.5em" height="1.4em" layoutType="Image" bindingId="typeWithStatusImage" />
                  <Col height="2.5em">
                    <Row layoutType="itemIdentifier" bindingId="Description" />
                    <Row layoutType="itemPaddingTop">
                      <Col width="1.3em" height="1.6em" layoutType="Image" bindingId="DateImageId" />
                      <Col width="7em" layoutType="itemSecondary itemPaddingTop" bindingId="DateFrom" />
                      <Col width="1.3em" height="1.6em" layoutType="Image" bindingId="TimeImageId" />
                      <Col width="4.2em" layoutType="itemSecondary itemPaddingTop" bindingId="TimeFrom" />
                      <Col width="1.3em" height="1.6em" layoutType="Image" bindingId="ResponsibleImageId" />
                      <Col layoutType="itemValue" bindingId="Responsible" />
                    </Row>
                  </Col>
                </Apple>
              </Tablet>
              <Phone>
                <Default>
                  <Col width="1.3em" height="1.2em" layoutType="Image" bindingId="typeWithStatusImage" />
                  <Col flex="1">
                    <Row layoutType="itemIdentifier" bindingId="Description" />
                    <Row>
                      <Col width="1em" height="1em" layoutType="Image" bindingId="DateImageId" />
                      <Col width="3.7em" layoutType="itemSecondary" bindingId="DateFrom" />
                      <Col width="1em" height="1em" layoutType="Image" bindingId="TimeImageId" />
                      <Col width="2.4em" layoutType="itemSecondary" bindingId="TimeFrom" />
                      <Col width="1em" height="1em" layoutType="Image" bindingId="ResponsibleImageId" />
                      <Col layoutType="itemValue" bindingId="Responsible" />
                    </Row>
                  </Col>
                </Default>
                <Android>
                  <Col width="1.3em" height="1.2em" layoutType="Image" bindingId="typeWithStatusImage" />
                  <Col flex="1">
                    <Row layoutType="itemIdentifier" bindingId="Description" />
                    <Row>
                      <Col width="1em" height="1em" layoutType="Image" bindingId="DateImageId" />
                      <Col width="3.7em" layoutType="itemSecondary" bindingId="DateFrom" />
                      <Col width="1em" height="1em" layoutType="Image" bindingId="TimeImageId" />
                      <Col width="2.4em" layoutType="itemSecondary" bindingId="TimeFrom" />
                      <Col width="1em" height="1em" layoutType="Image" bindingId="ResponsibleImageId" />
                      <Col layoutType="itemValue" bindingId="Responsible" />
                    </Row>
                  </Col>
                </Android>
                <Apple>
                  <Col width="2em" height="1.4em" layoutType="Image" bindingId="typeWithStatusImage" />
                  <Col flex="1">
                    <Row layoutType="itemIdentifier" bindingId="Description" />
                    <Row>
                      <Col width="1.5em" layoutType="Image" bindingId="DateImageId" />
                      <Col width="6em" layoutType="itemSecondary" bindingId="DateFrom" />
                      <Col width="1.5em" layoutType="Image" bindingId="TimeImageId" />
                      <Col width="3em" layoutType="itemSecondary" bindingId="TimeFrom" />
                      <Col width="1.5em" layoutType="Image" bindingId="ResponsibleImageId" />
                      <Col layoutType="itemValue" bindingId="Responsible" />
                    </Row>
                  </Col>
                </Apple>
              </Phone>
            </ItemListLayout>
            <Bindings>
              <Binding target="DateFrom" type="Date" binding=".dateFrom" bindingMode="ONE_WAY" />
              <Binding target="TimeFrom" type="Text" binding=".timeFrom" bindingMode="ONE_WAY" />
              <Binding target="Description" type="Text" binding=".subject" bindingMode="ONE_WAY" />
              <Binding target="ClbStatus" type="Text" binding=".clbStatus" bindingMode="ONE_WAY" />
              <Binding target="Responsible" type="Text" binding=".responsibleName" bindingMode="ONE_WAY" />
              <Binding target="ClbStatusImage" type="Image" binding=".clbStatus.ImageId" bindingMode="ONE_WAY" />
              <Resource target="TimeImageId" type="Image" id="ClockGrey16" defaultImage="ClockGrey16" />
              <Resource target="DateImageId" type="Image" id="DayGrey16" defaultImage="DayGrey16" />
              <Resource target="ResponsibleImageId" type="Image" id="UserGrey16" defaultImage="UserGrey16" />
              <Binding target="typeWithStatusImage" type="Image" binding=".clbTypeStatus" bindingMode="ONE_WAY" />
            </Bindings>
          </Items>
        </GroupedList>
      </Area>
