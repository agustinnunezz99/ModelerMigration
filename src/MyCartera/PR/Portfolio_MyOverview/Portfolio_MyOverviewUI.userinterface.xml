      <!-- ESPECIALIDAD TAB - @VictorBosio - Historia FMG-90 -->
      <Area areaName="Especialidades" areaPattern="MultiArea" lazyLoading="true">
        <!-- Area donde se CARGAN todas las especialidades -->
        <Area areaName="ESPOverview" areaPattern="SingleElementArea">
          <!-- Grupo donde se obtienen y muestran la lista de Especialidades ya asignadas a la cartera -->
          <GroupedList name="ESPListOverview" searchable="false" groupBy="" dataSource="ProcessContext::PortfolioDetail.LoMyPortfolioESPRelation.Items[]" hasBorder="true">
            <Items name="Items" itemPattern="CustomerESPRelationItem">
              <ItemListLayout>
                <Default>
                  <!--  Mostrar el nombre de la especialidad-->
                  <Col width="8em">
                    <Row layoutType="itemIdentifier" bindingId="espName" />
                  </Col>
                </Default>
              </ItemListLayout>
              <!-- Bindings son los que asocian los valores de la lista y los asocian a los targets en el 'ItemListLayout'-->
              <Bindings>
                <Binding target="espName" type="Text" binding=".espName" bindingMode="ONE_WAY" />
              </Bindings>
            </Items>
            <Events></Events>
          </GroupedList>
        </Area>
      </Area>
      <!-- HORARIOS TAB - @VictorBosio - Historia FMG-90 -->
      <Area areaName="Horarios" areaPattern="MultiArea" lazyLoading="true">
        <!-- Area donde se CARGAN todos las Horarios -->
        <Area areaName="HorariosOverview" areaPattern="SingleElementArea">
          <MenuItems>
            <!-- Menu superior en donde ubicamos el boton 'Nuevo Horario' -->
            <MenuItem itemId="NewHorario" directlyVisible="true">
              <Bindings>
                <!-- Label e imagen mostrada en el boton 'Nuevo Horario' -->
                <Resource target="Text" type="Label" id="NewHorarioId" defaultLabel="Nuevo Horario" />
                <Resource target="Icon" type="Image" id="PlusDarkGrey24" defaultImage="PlusDarkGrey24" />
