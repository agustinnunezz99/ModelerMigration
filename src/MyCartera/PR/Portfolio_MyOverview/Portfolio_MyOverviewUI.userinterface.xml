              <Resource target="Title" type="Label" id="HorarioGroupId" defaultLabel="Horarios del Profesional" />
            </Bindings>
            <InputArea name="Name">
              <Bindings>
                <Resource target="Label" type="Label" defaultLabel="Nombre" id="HorarioNameId" />
                <Binding target="Value" binding="ProcessContext::ProfHoursDetail.name" bindingMode="TWO_WAY" />
              </Bindings>
            </InputArea>
            <CheckBox name="Monday">
              <Bindings>
                <Resource target="Label" type="Label" id="AvailableDaysId" defaultLabel="Lunes" />
                <Binding target="checkedValue" binding="ProcessContext::ProfHoursDetail.monday" bindingMode="TWO_WAY" />
              </Bindings>
            </CheckBox>
            <CheckBox name="Tuesday">
              <Bindings>
                <Resource target="Label" type="Label" id="AvailableDaysId" defaultLabel="Martes" />
                <Binding target="checkedValue" binding="ProcessContext::ProfHoursDetail.tuesday" bindingMode="TWO_WAY" />
              </Bindings>
            </CheckBox>
            <CheckBox name="Wednesday">
              <Bindings>
                <Resource target="Label" type="Label" id="AvailableDaysId" defaultLabel="Miercoles" />
                <Binding target="checkedValue" binding="ProcessContext::ProfHoursDetail.wednesday" bindingMode="TWO_WAY" />
              </Bindings>
            </CheckBox>
            <CheckBox name="Thursday">
              <Bindings>
                <Resource target="Label" type="Label" id="AvailableDaysId" defaultLabel="Jueves" />
                <Binding target="checkedValue" binding="ProcessContext::ProfHoursDetail.thursday" bindingMode="TWO_WAY" />
              </Bindings>
            </CheckBox>
            <CheckBox name="Friday">
              <Bindings>
                <Resource target="Label" type="Label" id="AvailableDaysId" defaultLabel="Viernes" />
                <Binding target="checkedValue" binding="ProcessContext::ProfHoursDetail.friday" bindingMode="TWO_WAY" />
              </Bindings>
            </CheckBox>
            <SelectionBox name="TimeFrom">
              <Bindings>
                <Resource target="Label" type="Label" id="TimeFromId" defaultLabel="Horario: Desde" />
                <Binding target="DataSource" toggleId="ProfHTime" bindingMode="TWO_WAY" />
                <Binding target="Value" binding="ProcessContext::ProfHoursDetail.timeFrom" bindingMode="TWO_WAY" />
              </Bindings>
              <Items>
                <Bindings>
                  <Binding target="ItemValue" type="Text" binding=".id" bindingMode="ONE_WAY" />
                  <Binding target="ItemText" type="Text" binding=".text" bindingMode="ONE_WAY" />
                </Bindings>
              </Items>
            </SelectionBox>
            <SelectionBox name="TimeUntil">
              <Bindings>
                <Resource target="Label" type="Label" id="TimeUntilId" defaultLabel="Horario: Hasta" />
                <Binding target="DataSource" toggleId="ProfHTime" bindingMode="TWO_WAY" />
                <Binding target="Value" binding="ProcessContext::ProfHoursDetail.timeUntil" bindingMode="TWO_WAY" />
              </Bindings>
              <Items>
                <Bindings>
                  <Binding target="ItemValue" type="Text" binding=".id" bindingMode="ONE_WAY" />
                  <Binding target="ItemText" type="Text" binding=".text" bindingMode="ONE_WAY" />
                </Bindings>
              </Items>
            </SelectionBox>
          </GroupElement>
        </Area>
